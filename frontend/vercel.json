{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://<YOUR-RENDER-BACKEND-URL>.onrender.com/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://<YOUR-RENDER-BACKEND-URL>.onrender.com/data/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
